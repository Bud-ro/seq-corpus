<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net462</TargetFrameworks>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>PCBATestToolkitClient</RootNamespace>
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
    <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
    <Version>1.2.0.251</Version>
    <AssemblyVersion>1.2.0.251</AssemblyVersion>
    <FileVersion>1.2.0.251</FileVersion>
  </PropertyGroup>

  <PropertyGroup>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.7.2" />
    <PackageReference Include="NUnit" Version="3.13.3" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PCBA.Test.Toolkit\PCBA.Test.Toolkit.csproj" />
  </ItemGroup>
</Project>